{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "graphify-out/**",
      "scripts/**",
      "supabase/**",
      "agent-tools/**",
      "preview-assets.html",
      "/cofffee.gif",
      "/walk.gif",
      "/lazy.gif",
      "/giphy*.gif",
      "/alcohol.png"
    ],
    "headers": [
      {
        "source": "**/*.@(js|css|html)",
        "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
      }
    ]
  },
  "firestore": {
    "rules": "firebase/firestore.rules"
  }
}
