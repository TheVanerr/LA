{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "graphify-out/**",
      "scripts/**",
      "V1/firebase.json",
      "agent-tools/**",
      "preview-assets.html"
    ],
    "headers": [
      {
        "source": "**/*.@(js|css|html)",
        "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
      }
    ]
  },
  "firestore": {
    "rules": "firebase/firestore.rules"
  }
}
