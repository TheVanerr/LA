rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /date_responses/{sessionId} {
      allow read: if false;
      allow create, update: if true;
      allow delete: if false;
    }

    match /date2_responses/{sessionId} {
      allow read: if false;
      allow create, update: if true;
      allow delete: if false;
    }

    match /date3_responses/{sessionId} {
      allow read: if false;
      allow create, update: if true;
      allow delete: if false;
    }
  }
}
